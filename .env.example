# Production: use the R2 custom domain, never the rate-limited r2.dev URL.
# Example: https://assets.tontongear.com
NEXT_PUBLIC_ASSET_BASE_URL=

# Optional emergency cache-buster. Prefer immutable, versioned object names.
NEXT_PUBLIC_ASSET_VERSION=

# Optional search-engine ownership verification values. Copy the token only,
# not the full HTML meta tag. Domain-property DNS verification remains valid.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Optional GA4 measurement ID, for example G-XXXXXXXXXX. When blank, no
# analytics script is loaded and no visitor data is sent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# IndexNow must use a real approved key and a matching public/<key>.txt file.
INDEXNOW_HOST=www.tontongear.com
INDEXNOW_KEY=


# Native Project Builder RFQ delivery through Resend.
# RFQ_FROM_EMAIL must use a sender/domain verified in the Resend account.
RESEND_API_KEY=
RFQ_FROM_EMAIL=
RFQ_TO_EMAIL=gary@tontonsportswear.com
